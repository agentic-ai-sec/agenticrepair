-	}
+        } else {
+            /* Duplicate namespace into destination tree to avoid potential use-after-free of the source ns */
+            xmlNodePtr _root = ret;
+            while (_root->parent != NULL) _root = _root->parent;
+            ret->ns = xmlNewNs(_root, ns->href, ns->prefix);
+            if (ret->ns == NULL) goto error;
+        }
     }
     if ((node->type == XML_ELEMENT_NODE) && (node->properties != NULL)) {
         ret->properties = xmlCopyPropList(ret, node->properties);