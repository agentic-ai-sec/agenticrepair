-        XXH_memcpy(state->buffer, input, (size_t)(bEnd-input));
+        { size_t copy_len = (size_t)(bEnd - input); if (copy_len > 16) copy_len = 16; XXH_memcpy(state->buffer, input, copy_len); }
         state->bufferedSize = (XXH32_hash_t)(bEnd-input);
     }