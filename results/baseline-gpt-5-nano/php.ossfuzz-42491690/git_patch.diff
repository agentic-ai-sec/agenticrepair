+            { size_t toCopy = (32 - state->memsize); if (len > toCopy) len = toCopy; { size_t _rem = 32 - state->memsize; size_t _cp = (len < _rem) ? len : _rem; XXH_memcpy((xxh_u8*)(state->mem32) + state->memsize, input, _cp); } }
             state->memsize += (XXH32_hash_t)len;
             return XXH_OK;
         }
 
