+            { size_t toCopy = (16 - state->memsize); if (len > toCopy) len = toCopy; { size_t _rem = 32 - state->memsize; size_t _cp = (len < _rem) ? len : _rem; XXH_memcpy((xxh_u8*)(state->mem32) + state->memsize, input, _cp); } }
             {   const xxh_u32* p32 = state->mem32;
                 state->v1 = XXH32_round(state->v1, XXH_readLE32(p32)); p32++;
                 state->v2 = XXH32_round(state->v2, XXH_readLE32(p32)); p32++;
@@ -1998,7 +1999,7 @@ XXH64_update (XXH64_state_t* state, const void* input, size_t len)
         state->total_len += len;
 
         if (state->memsize + len < 32) {  /* fill in tmp buffer */
