+                size_t copy_len = loadSize;
+                if (copy_len > toCopy) copy_len = toCopy;
+                XXH_memcpy(state->buffer + state->bufferedSize, input, copy_len);
+            } }
             input += loadSize;
             XXH3_consumeStripes(state->acc,
                                &state->nbStripesSoFar, state->nbStripesPerBlock,
@@ -4114,7 +4124,7 @@ XXH3_update(XXH3_state_t* state,
