+            { size_t toCopy = (32 - state->memsize); if (len > toCopy) len = toCopy; { size_t _rem = 32 - state->memsize; size_t _cp = (len < _rem) ? len : _rem; XXH_memcpy(((xxh_u8*)state->mem64) + state->memsize, input, _cp); } }
             state->memsize += (xxh_u32)len;
             return XXH_OK;
         }
@@ -2034,7 +2035,7 @@ XXH64_update (XXH64_state_t* state, const void* input, size_t len)
         }
 
         if (p < bEnd) {
-            XXH_memcpy(state->mem64, p, (size_t)(bEnd-p));
+            { size_t copy_len = (size_t)(bEnd - p); size_t toCopy = 32 - state->memsize; if (copy_len > toCopy) copy_len = toCopy; XXH_memcpy(state->mem64, p, copy_len); }
             state->memsize = (unsigned)(bEnd-p);
         }
     }
@@ -4071,7 +4072,11 @@ XXH3_update(XXH3_state_t* state,
         state->totalLen += len;
 
         if (state->bufferedSize + len <= XXH3_INTERNALBUFFER_SIZE) {  /* fill in tmp buffer */
-            XXH_memcpy(state->buffer + state->bufferedSize, input, len);
+            { size_t toCopy = (state->bufferedSize < 16) ? (16 - state->bufferedSize) : 0; if (len > toCopy) len = toCopy; {
+                size_t toCopy = 16 - state->bufferedSize;
+                if (len > toCopy) len = toCopy;
+                { size_t _rem = 16 - state->bufferedSize; size_t _cp = (len < _rem) ? len : _rem; XXH_memcpy(state->buffer + state->bufferedSize, input, _cp); }
+            } }
             state->bufferedSize += (XXH32_hash_t)len;
             return XXH_OK;
         }
@@ -4085,8 +4090,13 @@ XXH3_update(XXH3_state_t* state,
          * Complete it, then consume it.
          */
         if (state->bufferedSize) {
-            size_t const loadSize = XXH3_INTERNALBUFFER_SIZE - state->bufferedSize;
-            XXH_memcpy(state->buffer + state->bufferedSize, input, loadSize);
