@@ -5,6 +5,8 @@
 
 #include "internal_huf.h"
 
+static const uint8_t* fasthuf_table_end = NULL;
+
 #include "internal_memory.h"
 #include "internal_xdr.h"
 #include "internal_structs.h"
@@ -1183,10 +1185,17 @@ fasthuf_read_bits (
 {
     while (*bufferNumBits < numBits)
     {
+        if (fasthuf_table_end != NULL && *currByte >= fasthuf_table_end) {
+            break;
+        }
         *buffer = ((*buffer) << 8) | *((*currByte)++);
         *bufferNumBits += 8;
     }
 
+    if (*bufferNumBits < numBits) {
+        return 0;
+    }
+
     *bufferNumBits -= numBits;
     return ((*buffer) >> (*bufferNumBits)) & ((1 << numBits) - 1);
 }
